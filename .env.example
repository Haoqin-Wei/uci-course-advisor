# Copy this file to .env for local development. Do not commit .env.

# App mode: development, test, or production. Production enables stricter
# cookie, CSRF/origin, and secret handling defaults.
APP_ENV=development

# Required in production. Use a long random value generated outside the repo.
AUTH_SESSION_SECRET=

# Optional live LLM mode. Without a key, tests and local offline flows use
# deterministic fallbacks/fakes.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional external UCI data fallback.
ANTEATER_API_KEY=

# Optional controlled web search. Development defaults are usable without
# an API key; production must explicitly enable this.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=5

# Optional private-beta email delivery. Without RESEND_API_KEY, development
# logs that a verification code was issued but does not send email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SUBJECT=

# Private-beta identity and browser protections. Leave defaults for local
# development; production defaults are stricter when APP_ENV=production.
ALLOW_SHARED_DEMO=true
ALLOW_GUEST_USERS=true
COOKIE_SECURE=false
CSRF_PROTECTION=false
ALLOWED_ORIGINS=
ALLOW_CUSTOM_SYSTEM_PROMPT=true
