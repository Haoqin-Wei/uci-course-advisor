# Copy this file to .env for local development. Do not commit .env.

# App mode: development, test, or production. Production enables stricter
# cookie, CSRF/origin, and secret handling defaults.
APP_ENV=development

# Required in production. Use a long random value generated outside the repo.
AUTH_SESSION_SECRET=

# Optional live LLM mode. Without a key, tests and local offline flows use
# deterministic fallbacks/fakes.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional external UCI data fallback.
ANTEATER_API_KEY=
# Phase 1 deterministic ranking; fixed defaults are A-rate .6 / RMP .4.
# Full candidate ranking reads snapshots/cache, without per-course live fetches.
RECOMMENDATION_RANKING_ENABLED=false
# Intent-aware prefilter; independent opt-in, old paths remain available.
DYNAMIC_PREFILTER_ENABLED=false
# One bounded intent-parse call; timeout remains a visible unresolved plan.
# Optional override in seconds (default 12, clamped to 0.05-20).
FILTER_PLAN_TIMEOUT_SECONDS=12
# Optional JSON objects; empty uses the documented default configuration.
RECOMMENDATION_RANKING_WEIGHTS=
RECOMMENDATION_RANKING_RELIABILITY=
# Runtime-only automatic-term cache (ignored by Git).
TERM_STATE_PATH=data/runtime/term_state.json

# Evidence-backed long-term memory. SQLite is the default and requires no
# external service. Set MEMORY_PROVIDER=json only for rollback compatibility.
MEMORY_PROVIDER=sqlite
MEMORY_ROOT=data/memory
MEMORY_DB_PATH=data/memory/long_term_memory.db
MEMORY_MAX_ACTIVE_ITEMS=1000

# Structured academic records produced by the browser-side transcript parser.
# The original PDF and raw extracted text are never stored here.
ACADEMIC_DB_PATH=data/academic.db

# Public term/section snapshots (SQLite). Separate from student records.
CATALOG_DB_PATH=data/catalog.db
# Background sync of current/next-term sections (set false for offline work).
CATALOG_AUTO_SYNC_ENABLED=true

# Optional controlled web search. Development defaults are usable without
# an API key; production must explicitly enable this.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=5

# Private-beta identity and browser protections. Leave defaults for local
# development; production defaults are stricter when APP_ENV=production.
ALLOW_SHARED_DEMO=false
ALLOW_GUEST_USERS=false
COOKIE_SECURE=false
CSRF_PROTECTION=false
ALLOWED_ORIGINS=
ALLOW_CUSTOM_SYSTEM_PROMPT=true
